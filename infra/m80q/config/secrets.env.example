# /etc/alfred/secrets.env — SECRETOS del M80q (root, permisos 600). Nunca en git ni en el chat.
# Lo rellenas tú en el M80q: sudo nano /etc/alfred/secrets.env

# Bot de Telegram SÓLO para alertas del sistema (distinto del bot de Alfred). Créalo con @BotFather.
TELEGRAM_BOT_TOKEN=
# Tu chat con ese bot. Para averiguarlo: escribe cualquier cosa al bot y ejecuta
#   sudo alfred-notify --discover-chat-id
TELEGRAM_CHAT_ID=

# Contraseña de la interfaz local del Shelly (la pones tú en su web).
SHELLY_PASSWORD=
