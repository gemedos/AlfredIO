# /etc/alfred/m80q.env — configuración NO secreta del M80q.
# 10-base.sh copia este archivo si no existe. Edítalo con: sudo nano /etc/alfred/m80q.env
# Los secretos van aparte, en /etc/alfred/secrets.env (permisos 600).

# Tu usuario de Debian (el único que puede entrar por SSH). Vacío = el que ejecuta sudo.
ADMIN_USER=
# Usuario sin privilegios que ejecuta Docker rootless y, más adelante, Alfred.
ALFRED_USER=alfred

# Tailscale
TS_HOSTNAME=alfred-m80q
TS_TAG=tag:alfred

# Partición de datos cifrada (40-data-luks.sh rellena DATA_LUKS_UUID)
DATA_LUKS_UUID=
DATA_MOUNT=/srv/alfred

# Copias (restic). UUID del sistema de ficheros del disco USB: sudo blkid
BACKUP_DISK_UUID=
BACKUP_MOUNT=/mnt/alfred-backup

# Temperatura de la CPU (°C). Estimaciones: el i5-10500T tiene un máximo de unos 100 °C.
TEMP_WARN_C=85
TEMP_CRIT_C=95
TEMP_CRIT_MINUTES=5

# Consumo (Shelly Plug M Gen3). Vacío = sin vigilancia de consumo.
SHELLY_HOST=
SHELLY_USER=admin
# Estimaciones: el M80q gasta ~7-10 W en reposo y ~45-65 W a plena carga. Calibrar con datos reales.
POWER_WARN_W=65
POWER_WARN_MINUTES=10
